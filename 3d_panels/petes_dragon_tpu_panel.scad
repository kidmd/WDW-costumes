// Module for 2D stadium/oval
module stadium_2d(length, width) {
    hull() {
        translate([-(length - width)/2, 0])
            circle(d = width);
        translate([(length - width)/2, 0])
            circle(d = width);
    }
}

// Module for single notched oval collar
module single_collar() {
    difference() {
        // Outer oval collar wall
        linear_extrude(height = collar_height)
            stadium_2d(collar_inner_length + 2 * collar_wall_thickness, collar_inner_width + 2 * collar_wall_thickness);
        
        // Inner 10x5mm cavity
        translate([0, 0, -0.1])
            linear_extrude(height = collar_height + 0.2)
                stadium_2d(collar_inner_length, collar_inner_width);
        
        // Wire pass-through notches on both 5mm ends down to floor
        translate([(collar_inner_length + collar_wall_thickness)/2, 0, collar_height/2])
            cube([collar_wall_thickness * 2 + 1, notch_width, collar_height + 0.2], center = true);
        
        translate([-(collar_inner_length + collar_wall_thickness)/2, 0, collar_height/2])
            cube([collar_wall_thickness * 2 + 1, notch_width, collar_height + 0.2], center = true);
    }
}

module open_chassis_tpu_armor() {
    difference() {
        union() {
            // 1. SOLID CONTINUOUS FRONT PLATE (Z = 0 to 2.0mm)
            linear_extrude(height = front_thickness, convexity = 10)
                polygon(points = contour_pts);

            // 2. 4.0mm PERIMETER WALL RIM (Z = 2.0 to 6.0mm)
            translate([0, 0, front_thickness])
                linear_extrude(height = perimeter_rim_height, convexity = 10)
                    difference() {
                        polygon(points = contour_pts);
                        offset(r = -rim_wall_thickness)
                            polygon(points = contour_pts);
                    }

            // 3. 16 BACKSIDE RIM FASTENER TABS (Z = 2.0 to 5.0mm)
            for (i = [0 : len(fastener_tabs)-1]) {
                translate([fastener_tabs[i][0], fastener_tabs[i][1], front_thickness])
                    difference() {
                        cylinder(d = fastener_tab_od, h = fastener_tab_height);
                        translate([0, 0, -0.1])
                            cylinder(d = fastener_hole_dia, h = fastener_tab_height + 0.2);
                    }
            }

            // 4. 100 NOTCHED OVAL COLLARS (Z = 2.0 to 5.0mm)
            for (i = [0 : len(ordered_leds)-1]) {
                translate([ordered_leds[i][0], ordered_leds[i][1], front_thickness])
                    rotate([0, 0, led_rotations[i]])
                        single_collar();
            }
        }

        // 5. 2x2mm SQUARE OPTICAL WINDOWS (Through front plate Z = -0.5 to 2.5mm)
        for (i = [0 : len(ordered_leds)-1]) {
            translate([ordered_leds[i][0], ordered_leds[i][1], front_thickness/2])
                rotate([0, 0, led_rotations[i]])
                    cube([window_square, window_square, front_thickness + 1.0], center = true);
        }

        // 6. DEBOSSED LED NUMBERS 1-100 ON INNER FLOOR (Z = 1.4 to 2.1mm)
        for (i = [0 : len(number_positions)-1]) {
            translate([number_positions[i][0], number_positions[i][1], front_thickness - 0.6])
                linear_extrude(height = 0.8)
                    text(str(i + 1), size = 2.8, valign = "center", halign = "center", font = "Liberation Sans:style=Bold");
        }
    }
}

